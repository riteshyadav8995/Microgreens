# ---- Contact form (Formspree) ----
# Create a form at https://formspree.io, then paste its endpoint (or just the form ID) here.
# Messages arrive in the email inbox linked to that Formspree form.
# On Vercel: Project → Settings → Environment Variables → VITE_FORMSPREE_ENDPOINT, then redeploy.
# (If this is left empty, the site uses the default form built into src/config/site.js.)
VITE_FORMSPREE_ENDPOINT=https://formspree.io/f/xoevdakp
